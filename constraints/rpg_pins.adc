//=============================================================================
// rpg_pins.adc —— 安路 TD 引脚约束(字符 RPG)
//
// ★ LOCATION 全是占位值, 必须按 HX4S20C 原理图逐条改!
//   本工程用到的引脚很少:
//     clk50      50MHz 有源晶振
//     rst_key_n  复位按键
//     key_n[3:0] 4 个用户按键(对应游戏里的 1/2/3/4)
//     led[3:0]   4 个 LED
//     hdmi_*     4 对差分 + 时钟对
//
//   注意: HDMI 必须落在支持 LVDS 的差分对上, P/N 同组。
//         TD 只需约束 P 端, N 端自动配对。
//=============================================================================

set_pin_assignment { clk50 }       { LOCATION = R7;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { rst_key_n }   { LOCATION = T6;  IOSTANDARD = LVCMOS33; }

set_pin_assignment { key_n[0] }    { LOCATION = P4;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_n[1] }    { LOCATION = P5;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_n[2] }    { LOCATION = R4;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { key_n[3] }    { LOCATION = R5;  IOSTANDARD = LVCMOS33; }

set_pin_assignment { led[0] }      { LOCATION = M2;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { led[1] }      { LOCATION = N1;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { led[2] }      { LOCATION = N2;  IOSTANDARD = LVCMOS33; }
set_pin_assignment { led[3] }      { LOCATION = P2;  IOSTANDARD = LVCMOS33; }

//---------------- HDMI ----------------
set_pin_assignment { hdmi_clk_p }  { LOCATION = R1;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_clk_n }  { LOCATION = R2;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_p[0] } { LOCATION = P1;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_n[0] } { LOCATION = T1;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_p[1] } { LOCATION = N3;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_n[1] } { LOCATION = N4;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_p[2] } { LOCATION = M3;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_n[2] } { LOCATION = M4;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_p[3] } { LOCATION = L1;  IOSTANDARD = LVDS25; }
set_pin_assignment { hdmi_d_n[3] } { LOCATION = L2;  IOSTANDARD = LVDS25; }
